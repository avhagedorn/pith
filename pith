#!/bin/sh
set -eu
# Follow symlinks, so this can be linked into a directory on PATH.
SELF=$0
while [ -L "$SELF" ]; do
  TARGET=$(readlink "$SELF")
  case $TARGET in
    /*) SELF=$TARGET ;;
    *) SELF=$(dirname -- "$SELF")/$TARGET ;;
  esac
done
DIR=$(CDPATH= cd -- "$(dirname -- "$SELF")" && pwd)
if [ ! -f "$DIR/dist/src/cli.js" ]; then
  printf '%s\n' 'Run npm install --ignore-scripts && npm run build in the pith directory first.' >&2
  exit 1
fi
exec node "$DIR/dist/src/cli.js" "$@"
